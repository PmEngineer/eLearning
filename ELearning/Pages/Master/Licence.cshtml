@page "/Licence/{Id?}"
@model ELearning.Pages.Master.LicenceModel
@{
}
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
<link href="~/css/form.css" rel="stylesheet" type="text/css" />
<script src="~/bootcatch-sidebar-master/js/jquery.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">*@
<script src="https://code.jquery.com/jquery-1.9.1.min.js"></script>
@*<link href="~/css/Fonts/Fonts.css" rel="stylesheet" />*@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf/notyf.min.css">
<script src="https://cdn.jsdelivr.net/npm/notyf/notyf.min.js"></script>
<style>
    .tbl {
        height: 100%;
        overflow: none;
    }

    button.fa.fa-trash-o.fs-4 {
        border: none;
    }

    .card-header {
        color: #fff;
    }
</style>
<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-primary mainh">Licence</div>
        <div class="card-body">
            <div>
                <form class="form row g-3" method="post" enctype="multipart/form-data">

                    <div class="dfelx">
                        <div class="flex-fill">
                            <div class="did-floating-label-content">
                                <input type="hidden" asp-for="licence.Id" />
                                <input type="hidden" asp-for="licence.CreatedBy" />
                                <input type="hidden" asp-for="licence.CreatedDate" />
                                <input class="did-floating-input" type="text" placeholder=" " asp-for="licence.LicenceKey">
                                <label class="did-floating-label">Licence Key</label>
                            </div>
                        </div>
                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="date" id="startdate" onchange="calculateDuration()"  placeholder=" " asp-for="licence.StartDate">
                                <label class="did-floating-label">Start Date</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="date" placeholder=" " onchange="calculateDuration()" id="enddate" asp-for="licence.EndDate">
                                <label class="did-floating-label">End Date</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="text" placeholder=" " id="duration" asp-for="licence.Duration" readonly>
                                <label class="did-floating-label">Licence Duration</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <select class=" did-floating-select select2" asp-for="licence.CompanyId">

                                    @foreach (var item in Model.getCompanies)
                                    {

                                        <option value="@item.Id">@item.Name</option>

                                    }
                                </select>
                                <label class="did-floating-label">Company Name</label>
                            </div>
                        </div>

    

                        <div class="flex-fill" style="text-align:center;">
                            <input type="submit" value="@Model.value" class="btn btn-primary shadow rounded" />
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>

</div>
<div class="container-fluid mt-3">
    <div class="card">
        <div class="card-header">List</div>
        <div class="card-body tbl">
            <table class="table" id="dtdata">
                <thead>
                    <tr>
                        <th>SrNo</th>
                        <th>Licence Key</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Duration</th>
                        <th>Company Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var srno = 1;
                    }
                     @if(Model.licence !=null)
                    {
                    @foreach (var item in Model.licences)
                    {
                        <tr>

                            <td>@srno</td>
                            <td>@item.LicenceKey</td>
                            <td>@item.StartDate</td>
                            <td>@item.EndDate</td>
                            <td>@item.Duration</td>
                            <td>@item.company.Name</td>
                           

                            <td>
                                <a href="/Licence/@item.Id" class="fas fa-edit text-success"></a>&nbsp;

                                <button class="fa fa-trash-o fs-4 text-danger" asp-page="Course" asp-page-handler="Delete"
                                        asp-route-Id="@item.Id" data-bs-toggle="modal" data-bs-target="#deleteModal" onclick="DisplayConfirmDeleteModal(@item.Id)">
                                </button>

                            </td>

                        </tr>
                        srno++;
                    }
                    }
                </tbody>
            </table>


            <!-- Modal -->
            <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-warning">
                            <h1 class="modal-title fs-5" id="exampleModalLabel">Delete</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Do You really want to Delete??
                        </div>
                        <div class="modal-footer">
                            <form method="Post" asp-page-handler="Delete">
                                <input type="hidden" id="idtoDelete" asp-for="@Model.Id" class="form-control" />

                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                @*<a id="deletes" class="fa fa-trash-o fs-4 text-danger" asp-page="Country" asp-page-handler="Delete"
                                asp-route-Id="" ></a>*@
                                <button asp-page-handler="Delete" class="btn btn-danger db">Delete</button>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/bootcatch-sidebar-master/js/jquery.min.js"></script>
<script type="text/javascript" src="~/js/DateNotyf.js"></script>
<script type="text/javascript" src="~/js/RestrictPreviousDate.js"></script>
<script type="text/javascript">
    function DisplayConfirmDeleteModal(Id) {
        $("#idtoDelete").val(Id);
        //$(".db").attr('asp-route-id', Id);
    }    
</script>
