@page "/Faculty/{Id?}"
@model ELearning.Pages.Master.FacultyModel
@{
}
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
<link href="~/css/form.css" rel="stylesheet" type="text/css" />
<script src="~/bootcatch-sidebar-master/js/jquery.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">*@
<script src="https://code.jquery.com/jquery-1.9.1.min.js"></script>
@*<link href="~/css/Fonts/Fonts.css" rel="stylesheet" />*@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf/notyf.min.css">
<script src="https://cdn.jsdelivr.net/npm/notyf/notyf.min.js"></script>
<style>
    .tbl {
        height: 100%;
        overflow: none;
    }

    button.fa.fa-trash-o.fs-4 {
        border: none;
    }

    .card-header {
        color: #fff;
    }
</style>
<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-primary mainh">Faculty</div>
        <div class="card-body">
            <div>
                <form class="form row g-3" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="targetFolder" value="Faculty_Image"/>
                    <div class="dfelx">

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <select class=" did-floating-select select2" asp-for="Faculty.CompanyId">

                                    @foreach (var item in Model.getCompanies)
                                    {

                                        <option value="@item.Id">@item.Name</option>

                                    }
                                </select>
                                <label class="did-floating-label">Company Name</label>
                            </div>
                        </div>
                        <div class="flex-fill">
                            <div class="did-floating-label-content">
                                <input type="hidden" asp-for="Faculty.Id" />
                                <input type="hidden" asp-for="Faculty.CreatedBy" />
                                <input type="hidden" asp-for="Faculty.CreatedDate" />
                                <input class="did-floating-input" type="text" placeholder=" " asp-for="Faculty.Name">
                                <label class="did-floating-label">Name</label>
                            </div>
                        </div>
                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="file" accept=".png,.jpg,.jpeg,.gif" name="formFile" id="fileuplode" placeholder=" " asp-for="Faculty.Image">
                                <label class="did-floating-label">Select Image File</label>
                            </div>
                        </div>
                        @{
                            if(Model.Faculty.Id>0)
                            {
                                <div class="flex-fill">
                                  <div class="form-check">
                                        <label>Image</label>
                                        <br />
                                        <img src="/Faculty_Image/Images/@Model.Faculty.Image" height="40" width="40" alt="Lternate text" />
                                    </div>
                                </div>
                            }
                        }
                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="text" placeholder=" " asp-for="Faculty.Email">
                                <label class="did-floating-label">Email</label>
                            </div>
                        </div>
                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="text" placeholder=" " asp-for="Faculty.Contact">
                                <label class="did-floating-label">Contact</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="text" placeholder=" " asp-for="Faculty.Address">
                                <label class="did-floating-label">Address</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="text" placeholder=" "  asp-for="Faculty.Qualification">
                                <label class="did-floating-label">Qualification</label>
                            </div>
                        </div>

                       



                        <div class="flex-fill" style="text-align:center;">
                            <input type="submit" value="@Model.value" class="btn btn-primary shadow rounded" />
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>

</div>
<div class="container-fluid mt-3">
    <div class="card">
        <div class="card-header">List</div>
        <div class="card-body tbl">
            <table class="table" id="dtdata">
                <thead>
                    <tr>
                        <th>SrNo</th>
                        <th>Company Name</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Email</th>
                        <th>Contact</th>
                        <th>Address</th>
                        <th>Qualification</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var srno = 1;
                    }
                    @if (Model.Faculty != null)
                    {
                        @foreach (var item in Model.Faculties)
                        {
                            <tr>

                                <td>@srno</td>
                                <td>@item.Company.Name</td>
                                <td>@item.Name</td>
                                <td scope="row"><img src="/Faculty_Image/Images/@item.Image" height="40" width="40" alt="Lternate text" /></td>
                                <td>@item.Email</td>
                                <td>@item.Contact</td>
                                <td>@item.Address</td>
                                <td>@item.Qualification</td>


                                <td>
                                    <a href="/Faculty/@item.Id" class="fas fa-edit text-success"></a>&nbsp;

                                    <button class="fa fa-trash-o fs-4 text-danger" asp-page="Course" asp-page-handler="Delete"
                                            asp-route-Id="@item.Id" data-bs-toggle="modal" data-bs-target="#deleteModal" onclick="DisplayConfirmDeleteModal(@item.Id)">
                                    </button>

                                </td>

                            </tr>
                            srno++;
                        }
                    }
                </tbody>
            </table>


            <!-- Modal -->
            <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-warning">
                            <h1 class="modal-title fs-5" id="exampleModalLabel">Delete</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Do You really want to Delete??
                        </div>
                        <div class="modal-footer">
                            <form method="Post" asp-page-handler="Delete">
                                <input type="hidden" id="idtoDelete" asp-for="@Model.Id" class="form-control" />

                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                @*<a id="deletes" class="fa fa-trash-o fs-4 text-danger" asp-page="Country" asp-page-handler="Delete"
                                asp-route-Id="" ></a>*@
                                <button asp-page-handler="Delete" class="btn btn-danger db">Delete</button>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/bootcatch-sidebar-master/js/jquery.min.js"></script>
<script type="text/javascript">
    function DisplayConfirmDeleteModal(Id) {
        $("#idtoDelete").val(Id);
        //$(".db").attr('asp-route-id', Id);
    }
</script>