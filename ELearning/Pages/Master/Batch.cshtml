@page "/Batch/{Id?}"
@model ELearning.Pages.Master.BatchModel
@{
}
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
<link href="~/css/form.css" rel="stylesheet" type="text/css" />
<script src="~/bootcatch-sidebar-master/js/jquery.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">*@
<script src="https://code.jquery.com/jquery-1.9.1.min.js"></script>
@*<link href="~/css/Fonts/Fonts.css" rel="stylesheet" />*@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf/notyf.min.css">
<script src="https://cdn.jsdelivr.net/npm/notyf/notyf.min.js"></script>
<style>
    .tbl {
        height: 100%;
        overflow: none;
    }

    button.fa.fa-trash-o.fs-4 {
        border: none;
    }

    .card-header {
        color: #fff;
    }
</style>
<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-primary mainh">Batch</div>
        <div class="card-body">
            <div>
                <form class="form row g-3" method="post" enctype="multipart/form-data">

                    <div class="dfelx">

                        <div class="col-2 flex-fill">
                            <div class="did-floating-label-content">

                                <select class=" did-floating-select select2" asp-for="Batch.CourseId" id="courseSelect">

                                    @foreach (var item in Model.GetCourses)
                                    {

                                        <option value="@item.Id">@item.Name</option>

                                    }
                                </select>
                                <label class="did-floating-label">Course Name</label>
                            </div>
                        </div>
                        <div class="flex-fill">
                            <div class="did-floating-label-content">
                                <input type="hidden" asp-for="Batch.Id" />
                                <input type="hidden" asp-for="Batch.CreatedBy" />
                                <input type="hidden" asp-for="Batch.CreatedDate" />
                                <input class="did-floating-input" type="text" placeholder=" " asp-for="Batch.Name" id="batchName">
                                <label class="did-floating-label">Batch Name</label>
                            </div>
                        </div>
                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="date" id="startdate" onchange="calculateValidity()" placeholder=" " asp-for="Batch.StartDate">
                                <label class="did-floating-label">Batch Start Date</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="date" placeholder=" " onchange="calculateValidity()" id="enddate" asp-for="Batch.EndDate">
                                <label class="did-floating-label">Batch End Date</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="text" placeholder=" " id="validity" asp-for="Batch.Validity" readonly>
                                <label class="did-floating-label">Batch Validity</label>
                            </div>
                        </div>

                        <div class="flex-fill">
                            <div class="did-floating-label-content">

                                <input class="did-floating-input" type="text" placeholder=" " id="duration" asp-for="Batch.Duration" >
                                <label class="did-floating-label">Batch Duration</label>
                            </div>
                        </div>
                        <div class="flex-fill" style="text-align:center;">
                            <input type="button" value="@Model.value" class="btn btn-primary shadow rounded" id="save"/>
                        </div>
                    </div>
                   

                    <div class="container-fluid">
                        <div class="card">
                            <div class="card-header bg-primary mainh">Add Subject</div>
                            <div class="card-body">
                                <div>
                                    <div class="dfelx">
                                        <div class="col-2 flex-fill">
                                            <div class="did-floating-label-content">
                                                <select class="did-floating-select select2" id="subjectSelect">
                                                    @foreach (var item in Model.GetSubjects)
                                                    {
                                                        <option value="@item.Id" data-id="@item.Id">@item.Name</option>
                                                    }
                                                </select>
                                                <label class="did-floating-label">Subject Name</label>
                                            </div>
                                        </div>
                                        <div class="col-2 flex-fill">
                                            <div class="did-floating-label-content">

                                                <select class="did-floating-select select2" id="facultySelect">
                                                    @foreach (var item in Model.GetFaculties)
                                                    {
                                                        <option value="@item.Id" data-id="@item.Id">@item.Name</option>
                                                    }
                                                </select>
                                                <label class="did-floating-label">Faculty Name</label>
                                            </div>
                                        </div>
                                        <div class="flex-fill">
                                            <div class="did-floating-label-content">
                                                <input class="did-floating-input" type="time" placeholder=" " id="startTime">
                                                <label class="did-floating-label">Batch Start Time</label>
                                            </div>
                                        </div>
                                        <div class="flex-fill">
                                            <div class="did-floating-label-content">
                                                <input class="did-floating-input" type="time" placeholder=" " id="endTime">
                                                <label class="did-floating-label">Batch End Time</label>
                                            </div>
                                        </div>
                                        <div class="flex-fill" style="text-align:center;">
                                            <button type="button" class="btn btn-primary shadow rounded" id="addSubjectButton">
                                                <i class="fas fa-plus"></i> Add Subject
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Dynamic Subjects Table -->
                                    <div class="card-body tbl">
                                        <table class="table mt-3" id="subjectsTable">
                                            <thead>
                                                <tr>
                                                    <th>Subject Name</th>
                                                    <th>Faculty Name</th>
                                                    <th>Start Time</th>
                                                    <th>End Time</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Rows will be added dynamically here -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>

</div>



<script src="~/bootcatch-sidebar-master/js/jquery.min.js"></script>
<script type="text/javascript" src="~/js/DateNotyf.js"></script>
<script type="text/javascript" src="~/js/RestrictPreviousDate.js"></script>
<script type="text/javascript">
    function DisplayConfirmDeleteModal(Id) {
        $("#idtoDelete").val(Id);
        //$(".db").attr('asp-route-id', Id);
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#addSubjectButton').on('click', function () {
            let subjectName = $('#subjectSelect option:selected').text();
            let subjectId = $('#subjectSelect option:selected').data('id'); 
            let facultyName = $('#facultySelect option:selected').text();
            let facultyId = $('#facultySelect option:selected').data('id'); 
            let startTime = $('#startTime').val();
            let endTime = $('#endTime').val();

            if (subjectName && facultyName && startTime && endTime) {
               
                let newRow = `<tr>
                    <td>${subjectName}<input type='hidden' name='subjects[${subjectId}].subjectId' value='${subjectId}'/></td>
                    <td>${facultyName}<input type='hidden' name='subjects[${facultyId}].facultyId' value='${facultyId}'/></td>
                    <td>${startTime}</td>
                    <td>${endTime}</td>
                    <td><button class="btn btn-danger delete-button"><i class="fas fa-trash"></i></button></td>
                </tr>`;

                $('#subjectsTable tbody').append(newRow);

               
                $('#subjectSelect').val('').trigger('change');
                $('#facultySelect').val('').trigger('change');
                $('#startTime').val('');
                $('#endTime').val('');
            } else {
                alert("Please fill all fields.");
            }
        });

        $('#subjectsTable').on('click', '.delete-button', function () {
            $(this).closest('tr').remove();
        });
    });
</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
       
        $("#save").click(function () {
            var Course = $("#courseSelect").val();
            var Batch = $("#batchName").val();
            var StartDate = $("#startdate").val();
            var EndDate = $("#enddate").val();
            var Validity = $("#validity").val();
            var Duration = $("#duration").val();

          
            let subjects = [];

            $('#subjectsTable tbody tr').each(function () {
               // let subjectName = $(this).find('td:eq(0)').text().trim();
                let subjectId = $(this).find('input[name*="subjectId"]').val();
                let facultyId = $(this).find('input[name*="facultyId"]').val();
               // let facultyName = $(this).find('td:eq(1)').text().trim();
                let startTime = $(this).find('td:eq(2)').text().trim();
                let endTime = $(this).find('td:eq(3)').text().trim();

              
                subjects.push({
                    //subjectName: subjectName,
                    SubjectId: subjectId,
                    FacultyId: facultyId,
                    //facultyName: facultyName,
                    StartTiming: startTime,
                    EndTiming: endTime
                });
            });

           
            const batchData = {
                CourseId: Course,
                Name: Batch,
                StartDate: StartDate,
                EndDate: EndDate,
                Duration: Duration,
                Validity: Validity,
                BatchSubjects: subjects
            };

            $.ajax({
                type: 'POST',
                url: '@Url.Action("AddBatch", "MasterBatch")',
              
                data: batchData,
                success: function (response) {
                    $('#result').html(response.message);
                    $("#courseSelect").val('').trigger('change');
                    $("#batchName").val('');
                    $("#startdate").val('');
                    $("#enddate").val('');
                    $("#validity").val('');
                    $("#duration").val('');

                    // Clear subjects table
                    $('#subjectsTable tbody').empty();
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error: ", status, error);
                    console.log(xhr.responseText);
                }

            })
             
           
        });
       
          
    });
</script>