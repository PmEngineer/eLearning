                        <input class="did-floating-input" type="hidden" value="1" id="hidden1" />
                    </div>

                </div>




            </div>


        </div>
    </div>
</div>
<!-- Button trigger modal -->
<div class="modal fade" id="SubjectModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header " style="background:green;">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-6 ">
                            <h6 class="text-white">Subject</h6>
                        </div>
                        <div class="col-6">
                            <h6 class="text-white">Total Question</h6>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    @{
                        var sr = 1;
                    }
                    @foreach (var item in Model.subjects)
                    {
                        <div class="row mt-3" id="textsubjectModel">
                            <div class="col-6" id="txtSub">

                                <input type="checkbox" id="@("isActive"+sr)" />
