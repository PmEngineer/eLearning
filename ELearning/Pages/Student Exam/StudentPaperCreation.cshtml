                    </div>
                    <div class=" did-floating-label-content col-1">
                        <input class="did-floating-input" type="text" id="Part1" value="1" />
                        <label class="did-floating-label">Part</label>

                    </div>
                    <div class=" did-floating-label-content col-1">
                        <input class="did-floating-input" type="text" id="Sequence1" value="1" />
