@page "/StudentPaper"
@model ELearning.Pages.Student_Exam.StudentPaperCreationModel
@{
}
<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-primary mainh">

            <h5 class="text-white">Paper Creation</h5>


        </div>
        <div class="card-body">
            <div>
                <form class="form" method="post">
                    <div>
                        <a href="" style="font-size:15px"> Add Course And Subject</a>
                    </div>

                    <div class="row mt-4">
                        <div class=" did-floating-label-content col-3">
                            <input type="hidden" id="txtsubPaperId" />
                            <select class="did-floating-select select2" id="CourseId">

                                <option value="0">Select Course</option>

                                @foreach (var item in Model.courses)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                            <label class="did-floating-label" id="txtCourseIdlbl">Course</label>
                        </div>
                        <div class=" did-floating-label-content col-3">
                            <input class="did-floating-input" type="text" id="TotalQuestion" onkeyup="MaxMArks()" />
                            <label class="did-floating-label" id="txttotalQueslbl">Total Question</label>
                        </div>
                        <div class=" did-floating-label-content col-3">
                            <input class="did-floating-input" type="text" id="MarksId" onkeyup="MaxMArks()" />
                            <label class="did-floating-label" id="txtMarkslblId">Marks/Ques</label>
                        </div>
                        <div class=" did-floating-label-content col-3">
                            <input class="did-floating-input" type="text" id="MaxMarkId" />
                            <label class="did-floating-label" id="txtMaxmarkidlbl">Max.Marks</label>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class=" did-floating-label-content col-3">
                            <select class="did-floating-select select2" id="languageId">
                                <option value="0">Select Language</option>

                                <option value="1">Hindi</option>
                                <option value="2">English</option>
                                <option value="3">Both</option>
                            </select>
                            <label class="did-floating-label" id="txtlanguageidlbl">Language</label>
                        </div>
                        <div class=" did-floating-label-content col-3">
                            <input class="did-floating-input" type="text" id="NegativeId" value="0.25" />
                            <label class="did-floating-label" id="txtNegativeIdlbl">Negative</label>
                        </div>
                        <div class=" did-floating-label-content col-3">
                            <input class="did-floating-input" type="text" id="DurationId" />
                            <label class="did-floating-label" id="txtDurationIdlbl">Duration(In Minuts)</label>
                        </div>
                        <div class=" did-floating-label-content col-2">
                            <input class="did-floating-input" type="text" id="PassMId" value="40" />
                            <label class="did-floating-label" id="txtPassMIdlbl">Pass Marks(%)</label>
                        </div>
                        <div class="col-1" style="margin-left: -14px;">
                            <input type="button" value="Save Paper" class="btn shadow rounded " style="background: linear-gradient(75.7deg, rgb(34, 126, 34) 3.8%, rgb(99, 162, 17) 87.1%); color:white" onclick="SavePaper()" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="card" id="PaperCreation">
        <div id="PaperCreationCard" class="txtPaperCreationCard">

            <div class="card-header bg-primary mainh">

                <div class="row">
                    @*  <div class="col-3">
                    <h6 class="text-center text-white">Paper Name</h6>
                    </div>
                    <div class="col-2">
                    <h6 class="text-center text-white">Total Questions</h6>
