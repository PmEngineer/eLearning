<script>
    var z = 1;
    function PaperCreationAdd() {
        // var Count = $('#PaperCreationCard #PaperCreationCardchild').length;

        var Count = $('#PaperCreationCard #PaperCreationCardchild').length;
        var d = $("#PaperCreationCardchild").clone();




        $(d).find("#subjectsId1").attr("id", "subjectsId" + (Count + 1));
        $(d).find("#PaperNameId1").attr("id", "PaperNameId" + (Count + 1));
        $(d).find("#txtPamerNameIdlbl1").attr("id", "txtPamerNameIdlbl" + (Count + 1));
        $(d).find("#number1").attr("id", "number" + (Count + 1));
        $(d).find("#txtPaperNameId1").attr("id", "txtPaperNameId" + (Count + 1));
        $(d).find("#txtSubjectLinkId1").attr("id", "txtSubjectLinkId" + (Count + 1));
        $(d).find("#txtbtnLessonId1").attr("id", "txtbtnLessonId" + (Count + 1));
        $(d).find("#txtLessonLink1").attr("id", "txtLessonLink" + (Count + 1));
        $(d).find("#txtSubLink1").attr("id", "txtSubLink" + (Count + 1));

        $(d).find("#totalQuestion1").attr("id", "totalQuestion" + (Count + 1));
        $(d).find("#txtheadPart1").attr("id", "txtheadPart" + (Count + 1));
        $(d).find("#Part1").attr("id", "Part" + (Count + 1));
        $(d).find("#Sequence1").attr("id", "Sequence" + (Count + 1));
        $(d).find("#pass1").attr("id", "pass" + (Count + 1));








        d.insertAfter("div#PaperCreationCardchild:last");

       // z = z + 1;
        $('#number' + (Count + 1)).val((Count + 1));
        $('#txtPaperNameId' + (Count + 1)).show();
        $('#txtSubjectLinkId' + (Count + 1)).show();
        $('#txtbtnLessonId' + (Count + 1)).hide();
        $("#PaperNameId" + Count+1).val('');
        $("#totalQuestion" + (Count+1)).val('');
        $('#txtPaperNameId' + (Count + 1)).show();
        $('#txtSubjectLinkId' + (Count + 1)).show();
        $('#txtbtnLessonId' + (Count + 1)).hide();
        $('#subjectsId' + (Count + 1)).val(0);



    }
    function subjectModal(id) {
        var Count = $('#textsubjectModel #txtSub').length;

        var d = id.slice(-1)
        for (i = 1; i <= Count; i++) {
            $('#subSeqNumber' + i).val(d);
            $('#txttotalQuestion' + i).val('');
            $('#isActive' + i).prop("checked", false);
        }

        var pId = $('#txtsubPaperId').val();
        $.ajax({
            type: "GET",
            url: "/Student/GetPaperSubjectBypId?pid=" + pId + "&seqNo=" + d,
            dataType: "json",
            success: function (result) {
                console.log(result);
                if (result.length > 0) {
                    for (j = 0; j < result.length; j++) {
                        for (k = 1; k <= Count; k++) {
                            var seqNo = $('#subSeqNumber' + k).val();
                            var subId = $('#SubjectId' + k).val();

                            if (d == result[j].mainSeqNumber && subId == result[j].subjectID) {
                                $('#txttotalQuestion' + k).val(result[j].totalQuestion);
                                $('#isActive' + k).prop("checked", true);

                            }
                        }

                    }
                }
                else{
                    for (l = 1; l <= Count; l++) {
                        $('#txttotalQuestion' + l).val('');
                        $('#isActive' + l).prop("checked", false);
                    }
                }
            }
        });



        $('#SubjectModal').modal('show');
    }
    function Subject(id) {

        var d = id.slice(-1)

        var data = $('#' + id).val();
        if (data > 0) {
            $('#txtPaperNameId' + d).hide();
            $('#txtSubjectLinkId' + d).hide();
            $('#txtbtnLessonId' + d).show();

        }
        else {
            $('#txtPaperNameId' + d).show();
            $('#txtSubjectLinkId' + d).show();
            $('#txtbtnLessonId' + d).hide();
        }

    }
    function LessonBySubjectID(id,no) {


        var subId = id;
        $('#Lesson').empty();
        $('#tQuesteninLesson').text("");
        $('#SubjectTQuestionId').text("");
       var TQuestion = $('#txttotalQuestion' + no).val();
        $('#SubjectTQuestionId').text(TQuestion);
        var lesson = "";
        var Lession = "";
        $.ajax({
            type: "POST",
            url: "/Examination/GetLessonsBySubjectId?SubId=" + id,
            dataType: "json",
            success: function (result) {
                console.log(result);
                for (i = 0; i < result.length; i++) {
                    if (id == 11) {
                        subname = result[i].hindiName;
                    }
                    else {
                        subname = result[i].name;
                    }
                    Lession = Lession + '<h5 style="font-size:15px;margin-top:20px;"><input type="checkbox" style="height: 15px;width: 15px;" id="LessonActive' + i + '"/><input type="hidden" value="' + subId + '" id="SubjextId"><input type="hidden" value="' + result[i].id + '" id="LessonId' + i + '">&nbsp<b>' + subname + '<span style="color:green">(' + result[i].questionCount + ')</span></b></h5>'
                        + '<table width="100%" id="lessionTable">'

                        + '<tbody><tr style="background-color: green;color: white;  "><td style="padding: 10px;font-size:15px;">Single Choice/एकविकल्पी</td><td style="padding: 10px;font-size:15px;">Multiple Choice/बहुविकल्पी</td><td style="padding: 10px;font-size:15px;">Paragraph/अनुच्छेद</td></tr><tr style="margin-top:100px;">'
                        + '<td class="text-center " ><span class="" style="font-size:15px;color:blue">Total Question:' + result[i].singleQuestionCount + '</span><br /> <input type="text" id="SingleChoiceId' + i + '"style="width:45%; padding:5px;margin-right:2%;" placeholder="Total Question"  class="input1" onkeyup="LTQuestion()"/><input type="text" id="SingleMarksId' + i + '"style="width:45%; padding:5px" value="" placeholder="Marks."/></td>'
                        + '<td class="text-center "><span class="" style="font-size:15px;color:blue">Total Question:</span><br /><input type="text" style="width:45%; padding:5px;margin-right:2%;" id="MultipleChoiceId' + i + '" placeholder="Total Question"   class="input1" onkeyup="LTQuestion()"/><input type="text" style="width:45%; padding:5px;" id="MultipleMarksId' + i + '" value="" placeholder="Marks."/></td>'
                        + '<td class="text-center "><span class="" style="font-size:15px;color:blue">Total Question:' + result[i].paragraphQuestionCount + '</span><br />  <input type="text" style="width:45%; padding:5px;margin-right:2%;" id="ParagraphId' + i + '" placeholder="Total Question"  class="input1" onkeyup="LTQuestion()"/><input type="text" style="width:45%; padding:5px;" id="ParagraphMarks' + i + '" value="" placeholder="Marks."/></td>'
                        + '</tr></tbody> </table>'
                }
                $('#Lesson').append(Lession);



            }
        });
        $('#LessonModal').modal('show');
    }
    var subject = [];

    function UpdateSubject() {
        var newubject = [];
        var Count = $('#textsubjectModel #txtSub').length;
        var mainSub = $('#subSeqNumber1').val();
        //newubject = subject;
        for (j = 0; j < subject.length; j++) {
            if (subject[j].MainSeqNumber == mainSub) {
            }
            else{
                newubject.push(subject[j]);
            }
        }
       // console.log(newubject);
        subject = newubject;
        for (i = 1; i <= Count; i++) {
            var isChecked = $('#isActive' + i).is(':checked');
            if (isChecked == true) {
                var SubVal = $('#SubjectId' + i).val();
                var totalQuestion = $('#txttotalQuestion' + i).val();
                var numberSub = $('#subSeqNumber' + i).val();
                var obj1 = {
                    "SubjectID": SubVal,

                    "MainSeqNumber": numberSub,
                    "TotalQuestion": totalQuestion,

                }
                subject.push(obj1);
            }
        }
        $('#SubjectModal').modal('hide');
        console.log(subject);

    }
    var paperLesson = [];
    function UpdateLession() {

        var Count = $('#lessionTable tbody ').length;
        var newLesson = [];

        var subjectid = $('#SubjextId').val();
        //newubject = subject;
        for (j = 0; j < paperLesson.length; j++) {
            if (paperLesson[j].SubjectId == subjectid) {
            }
            else {
                newLesson.push(paperLesson[j]);
            }
        }
        // console.log(newubject);
        paperLesson = newLesson;

        for (i = 0; i < Count; i++) {
            var LessonActive = $('#LessonActive' + i).is(':checked');
            if (LessonActive == true) {
                var LessonIdVal = $('#LessonId' + i).val();
                var subjectvalue = $('#SubjextId').val();
                var SingleChoiceVal = $('#SingleChoiceId' + i).val();
                var SingleMarksVal = $('#SingleMarksId' + i).val();
                var MultipleChoiceVal = $('#MultipleChoiceId' + i).val();
                var MultipleMarksVal = $('#MultipleMarksId' + i).val();
                var ParagraphVal = $('#ParagraphId' + i).val();
                var ParagraphMarksVal = $('#ParagraphMarks' + i).val();
                var obj1 = {
                    "LessionId": LessonIdVal,
                    "SingleChoice": SingleChoiceVal,
                    "SubjectId": subjectvalue,
                    "SingleMarks": SingleMarksVal,
                    "MultipleChoice": MultipleChoiceVal,
                    "MultipleMarks": MultipleMarksVal,
                    "Paragraph": ParagraphVal,
                    "ParagraphMarks": ParagraphMarksVal,
                }
                paperLesson.push(obj1);
            }
        }
        $('#LessonModal').modal('hide');
        console.log(paperLesson);

    }
    function SavePaper() {
        var Count = $('#PaperCreationCard #PaperCreationCardchild').length;

        var courseVal = $('#CourseId').val();

        var totalQuestionVal = $('#TotalQuestion').val();

        var marksVal = $('#MarksId').val();

        var maxMarksVal = $('#MaxMarkId').val();

        var languageVal = $('#languageId').val();

        var NegativeVal = $('#NegativeId').val();

        var DurationVal = $('#DurationId').val();

        var passMarkVal = $('#PassMId').val();

        var mainpaper = [];
        for (i = 1; i <= Count; i++) {
            var SubjectVal = $('#subjectsId' + i).val();
            var PaperName = $('#PaperNameId' + i).val();
            var tQuestionval = $('#totalQuestion' + i).val();
            var partVal = $('#Part' + i).val();
            var Seqval = $('#Sequence' + i).val();
            var Passval = $('#pass' + i).val();
            var Number = $('#number' + i).val();
            var obj1 = {
                "PaperName": PaperName,
                "TotalQuestion": tQuestionval,
                "Part": partVal,
                "Sequence": Seqval,
                "Pass": Passval,
                "SeqNumber": Number,

            }

            mainpaper.push(obj1);
            if (SubjectVal>0){
                var obj2={
                    "SubjectID": SubjectVal,

                    "MainSeqNumber": Number,
                    "TotalQuestion": tQuestionval,
                }
                subject.push(obj2);
            }
        }
        console.log(subject);
         var dataAll = {
             "CourseId": courseVal,
             "TotalQuestion": totalQuestionVal,
             "Marks": marksVal,
            "MaxMarks": maxMarksVal,
             "Language": languageVal,
             "Negative": NegativeVal,
             "Duration": DurationVal,
            "PassMarks": passMarkVal,
             "paperMainSubjects": mainpaper,
             "paperSubjects": subject,
             "paperLessons": paperLesson,
         }
        $.ajax({
            type: "POST",
            url: "/Examination/InsertPaper",
            data: dataAll,
            dataType: "json",

            success: function (result) {
                console.log(result);
                 alert(result.message);
                 window.location.replace("/StudentPaper");

            }
        });

    }
    function Edit(no) {

        var Id = $('#Id' + no).val();


        $.ajax({
            type: "POST",
            url: "/Examination/GetPaperById?id=" + Id,
            dataType: "json",
            success: function (result) {
